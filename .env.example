# ── Obrigatórios ──────────────────────────────────────────────────────────────
# Token do bot Discord (discord.com/developers)
DISCORD_TOKEN=seu_token_aqui

# Groq API Key — GRATUITA (console.groq.com)
GROQ_API_KEY=sua_chave_groq_aqui

# ── Opcionais ─────────────────────────────────────────────────────────────────
# Modelo Groq (padrão: llama-3.1-70b-versatile)
# Opções: llama-3.1-70b-versatile | llama3-8b-8192 | mixtral-8x7b-32768
GROQ_MODEL=llama-3.1-70b-versatile

# Claude API (Anthropic) — PAGO, opcional
# Se definido, ativa o modo /modelo claude
# ANTHROPIC_API_KEY=sua_chave_claude_aqui
# CLAUDE_MODEL=claude-sonnet-4-6

# YouTube Data API v3 — GRATUITA (10.000 req/dia)
# Se definido, adiciona vídeos de hunt nas respostas /hunt
# Criar em: console.developers.google.com → YouTube Data API v3
# YOUTUBE_API_KEY=sua_chave_youtube_aqui

# KB extra via GitHub — GRATUITA
# URL do arquivo Markdown raw no seu repositório público
# Exemplo: https://raw.githubusercontent.com/SEU_USER/companion-tibia-kb/main/kb_extra.md
# KB_GITHUB_URL=https://raw.githubusercontent.com/SEU_USER/seu-repo/main/kb_extra.md
